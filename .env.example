# Servidor local apenas. Copie para .env.local; nunca compartilhe esse arquivo.
JOCA_AI_ENABLED=false
# Não habilitar antes de resolver a compatibilidade dos termos com o público infantil.
JOCA_ELIGIBILITY_REVIEWED=false
# Verificar no AI Studio que o projeto é Free e não possui faturamento habilitado.
JOCA_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
JOCA_ALLOWED_ORIGIN=http://127.0.0.1:5174

# POC Cloudflare: local por padrão. Gemini anterior preservado, sem uso nesta etapa.
JOCA_PROVIDER=local
JOCA_CF_MODE=disabled
JOCA_CF_REAL_AUTHORIZED=false
JOCA_CF_PRIVACY_REVIEWED=false
JOCA_CF_QUOTA_VERIFIED=false
